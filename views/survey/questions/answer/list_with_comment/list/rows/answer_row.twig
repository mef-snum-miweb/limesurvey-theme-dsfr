{#
/**
 * List with comment, list layout - DSFR Theme
 * DSFR-compliant radio button row
 *
 * Variables available:
 * @var $name
 * @var $id
 * @var $value
 * @var $check_ans
 * @var $checkconditionFunction
 * @var $labeltext
 * @var $li_classes
 */
#}
<!-- answer_row DSFR -->
<div class="fr-fieldset__element radio-item answer-item">
    {# LS6-COMPAT — à retirer après bascule 7.x (ADR-129, theme#67) :
   LS7 identifie l'item par la sous-question (`_S{{aid}}`) et non par la valeur. #}
{% set lsItemSuffix = aid is defined ? '_S' ~ aid : value %}
<div id='javatbd{{ name }}{{ lsItemSuffix }}' class="fr-radio-group">
        <input
            type="radio"
            name="{{ name }}"
            id="{{ id }}"
            value="{{ value }}"
            {{ check_ans }}
        />
        <label class="fr-label" for="{{ id }}">{{ processString(labeltext) }}</label>
    </div>
</div>
<!-- end of answer_row -->
