{#
/**
 * Gender question, radio item Html — DSFR
 * Même pattern que yesno/radio : fieldset + legend + un fr-radio-group
 * par item (le ul role=radiogroup sans fieldset n'est pas le composant
 * radio DSFR).
 *
 * @var $name
 * @var $fChecked
 * @var $mChecked
 * @var $naChecked
 * @var $noAnswer
 * @var $value
 */
#}

{# LS6-COMPAT — à retirer après bascule 7.x (ADR-129, theme#67).
   LS7 préfixe les ids d'items : javatbd{name}Y → javatbd{name}_CY. La version
   n'étant pas exposée aux templates, on la déduit du format du fieldname :
   SGQA `282267X4X21` en 6.x, `Q21` en 7.x. #}
{% set lsIsSix = name matches '/^\\d+X\\d+X\\d+/' %}


<!--Gender question, radio display -->

<!-- answer -->
<fieldset class="fr-fieldset ls-answers gender-button" aria-labelledby="ls-question-text-{{ basename }}">
    <legend class="fr-fieldset__legend fr-sr-only">{{ gT("Choose one of the following answers") }}</legend>
    <div class="fr-fieldset__content">
        <!-- Female -->
        <div class="fr-radio-group answer-item radio-item" id="javatbd{{ name }}{{ lsIsSix ? 'F' : '_CF' }}">
            <input
                type="radio"
                name="{{ name }}"
                id="answer{{ name }}F"
                value="F"
                {{ fChecked }}
            />
            <label class="fr-label" for="answer{{ name }}F">
                {{ gT('Female') }}
            </label>
        </div>

        <!-- Male -->
        <div class="fr-radio-group answer-item radio-item" id="javatbd{{ name }}{{ lsIsSix ? 'M' : '_CM' }}">
            <input
                type="radio"
                name="{{ name }}"
                id="answer{{ name }}M"
                value="M"
                {{ mChecked }}
            />
            <label class="fr-label" for="answer{{ name }}M">
                {{ gT('Male') }}
            </label>
        </div>

        <!-- No answer -->
        {% if noAnswer %}
            <div class="fr-radio-group answer-item radio-item noanswer-item" id="javatbd{{ name }}">
                <input
                    type="radio"
                    name="{{ name }}"
                    id="answer{{ name }}"
                    value=""
                    {{ naChecked }}
                />
                <label class="fr-label" for="answer{{ name }}">
                    {{ gT('No answer') }}
                </label>
            </div>
        {% endif %}
    </div>
</fieldset>
{{ C.Html.hiddenField('java' ~ name, value, ({'id' : 'java' ~ name,'disabled' : 'true'})) }}

<!-- end of answer -->
