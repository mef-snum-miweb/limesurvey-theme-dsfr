{#
/**
 * List radio 'Other' row - DSFR Theme
 * DSFR-compliant radio button with text input for "Other" option
 *
 * Variables available:
 * @var $name
 * @var $answer_other
 * @var $sDisplayStyle
 * @var $myfname
 * @var $othertext
 * @var $checkedState
 * @var $kpclass
 * @var $checkconditionFunction
 */
#}

{# LS6-COMPAT — à retirer après bascule 7.x (ADR-129, theme#70).
   LS7 renomme le champ « Autre » : {name}other → {name}_Cother. C'est un NOM
   de champ POST : un nom 6.x envoyé à un core 7.x est ignoré silencieusement.
   Détection par le format du fieldname (SGQA en 6.x, Q<qid> en 7.x). #}
{% set lsOtherSuffix = name matches '/^\\d+X\\d+X\\d+/' ? 'other' : '_Cother' %}


<!-- answer_row_other DSFR -->
<div class="fr-fieldset__element radio-item answer-item" {{ sDisplayStyle }}>
    <div id='javatbd{{ myfname }}' class="fr-radio-group">
        <input
            type="radio"
            value="-oth-"
            name="{{ name }}"
            id="SOTH{{ name }}"
            {{ checkedState }}
            aria-controls="answer{{ name }}othertext"
            onclick="{{ checkconditionFunction }}(this.value, this.name, this.type)"
        />
        <label class="fr-label" for="SOTH{{ name }}" id="label-id-{{ name }}">
            {{ processString(othertext) }}
        </label>
    </div>

    <!-- Text input for "Other" -->
    {# `t` n'est pas propagé dans ce sous-template rendu par LimeSurvey hors scope de layout_global.twig.
       On replie sur la langue active du questionnaire avec un libellé explicite (RGAA 11.1 label non vide). #}
    {% set _lang = aSurveyInfo.alanguageChanger.datas.sSelected|default('fr') %}
    {% set _ifOtherSpecify = (_lang == 'en') ? 'If other, please specify' : 'Si autre, précisez' %}
    <div class="fr-input-group fr-mt-1w">
        <label class="fr-label fr-sr-only" for="answer{{ name }}othertext">
            {{ _ifOtherSpecify }}
        </label>
        <input
            type="text"
            class="fr-input {{ kpclass }}"
            id="answer{{ name }}othertext"
            name="{{ name }}{{ lsOtherSuffix }}"
            title="{{ _ifOtherSpecify }}"
            {{ answer_other }}
            {% if numbers_only %} data-number="1" {% endif %}
        />
    </div>

    <script>
        // Auto-check le radio "Autre" quand l'utilisateur tape dans le champ texte
        $("#answer{{ name }}othertext").on("keyup",function(){
            if($.trim($(this).val())!=''){
                $('#SOTH{{ name }}').click();
            };
            {{ checkconditionFunction }}(this.value, '{{ name }}', 'text');
        });
    </script>
</div>
<!-- end of answer_row_other -->
