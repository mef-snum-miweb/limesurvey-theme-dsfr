{#
/**
 * Yes / No Question, radio item Html - DSFR
 *
 * @var $name                           $ia[1]
 * @var $yChecked
 * @var $nChecked
 * @var $naChecked
 * @var $noAnswer
 * @var $value                          $_SESSION['survey_'.Yii::app()->getConfig('surveyID')][$name]
 */
#}

{# LS6-COMPAT — à retirer après bascule 7.x (ADR-129, theme#67).
   LS7 préfixe les ids d'items : javatbd{name}Y → javatbd{name}_CY. La version
   n'étant pas exposée aux templates, on la déduit du format du fieldname :
   SGQA `282267X4X21` en 6.x, `Q21` en 7.x. #}
{% set lsIsSix = name matches '/^\\d+X\\d+X\\d+/' %}


<fieldset class="fr-fieldset" aria-labelledby="ls-question-text-{{ basename }}">
        <legend class="fr-fieldset__legend fr-sr-only">{{ gT("Choose one of the following answers") }}</legend>
        <div class="fr-fieldset__content">
            <!-- Yes -->
            <div class="fr-radio-group" id="javatbd{{ name }}{{ lsIsSix ? 'Y' : '_CY' }}">
                <input
                    type="radio"
                    name="{{ name }}"
                    id="answer{{ name }}Y"
                    value="Y"
                    {{ yChecked }}
                />
                <label class="fr-label" for="answer{{ name }}Y">
                    {{ gT('Yes') }}
                </label>
            </div>

            <!-- No -->
            <div class="fr-radio-group" id="javatbd{{ name }}{{ lsIsSix ? 'N' : '_CN' }}">
                <input
                    type="radio"
                    name="{{ name }}"
                    id="answer{{ name }}N"
                    value="N"
                    {{ nChecked }}
                />
                <label class="fr-label" for="answer{{ name }}N">
                    {{ gT('No') }}
                </label>
            </div>

            <!-- No answer -->
            {% if noAnswer %}
                <div class="fr-radio-group" id="javatbd{{ name }}">
                    <input
                        type="radio"
                        name="{{ name }}"
                        id="answer{{ name }}"
                        value=""
                        {{ naChecked }}
                    />
                    <label class="fr-label" for="answer{{ name }}">
                        {{ gT('No answer') }}
                    </label>
                </div>
            {% endif %}
        </div>
</fieldset>
{# Value for expression manager javascript (use id) ; no need to submit #}
{{ C.Html.hiddenField("java"~name,value,({
    'id' : "java"~name,
    'disabled' : true,
})) }}
